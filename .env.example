# Plantilla de variables de entorno. Copiala a ".env" y poné los valores
# reales (el .env NO se versiona ni se comparte).
#
#   cp .env.example .env
#
# Los valores de abajo son de EJEMPLO: no sirven para entrar a nada.

# ---- Base de datos PostgreSQL (servicio "db" del docker-compose) ----
POSTGRES_DB=cafeto_db
POSTGRES_USER=cafeto_user
POSTGRES_PASSWORD=cambiar_esta_clave

# ---- Django (servicio "web") ----
DJANGO_SECRET_KEY=poner-aca-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
