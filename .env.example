# Plantilla de variables de entorno. Copiala a ".env" y poné los valores
# reales (el .env NO se versiona ni se comparte).
#
#   cp .env.example .env
#
# Los valores de abajo son de EJEMPLO: no sirven para entrar a nada.

# ---- Base de datos PostgreSQL (servicio "db") ----
POSTGRES_DB=cafeto_db
POSTGRES_USER=cafeto_user
POSTGRES_PASSWORD=cambiar_esta_clave

# ---- Django (servicio "web") ----
# En producción: una clave larga y aleatoria, por ejemplo la salida de
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=poner-aca-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Sólo producción (docker-compose.prod.yml) ----
# Con qué nombre se entra desde afuera, separado por comas, con https://.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://cafeto.midominio.com.ar
# Si el NAS hace de proxy inverso con HTTPS, las dos en True:
# DJANGO_CONFIAR_EN_PROXY=True
# DJANGO_HTTPS=True
# GUNICORN_WORKERS=3
# CAFETO_RESPALDOS_DIAS=14

# ---- Sesiones ----
# CAFETO_SESION_HORAS=12
# CAFETO_INACTIVIDAD_MINUTOS=60

# ---- Correo (enlaces para elegir o recuperar la clave) ----
# Sin esto, en desarrollo los correos quedan como archivos en .correos/.
# Con una cuenta de Gmail: activar la verificación en dos pasos y crear una
# "contraseña de aplicación" (no es la clave de la cuenta).
# DJANGO_CORREO_SERVIDOR=smtp.gmail.com
# DJANGO_CORREO_PUERTO=587
# DJANGO_CORREO_USUARIO=cafeto.laslomitas@gmail.com
# DJANGO_CORREO_CLAVE=la-contraseña-de-aplicación
# DJANGO_CORREO_REMITENTE=Cafeto Las Lomitas <cafeto.laslomitas@gmail.com>

# ---- App móvil: cuentas de los clientes (Firebase) ----
# La cuenta de servicio va en secretos/firebase.json (fuera del repositorio:
# está en .gitignore) y docker compose la monta en /run/secrets/firebase.json.
# Sólo hace falta esta variable si se la pone en otro lado. Sin el archivo,
# /api/movil/clientes/ responde 503 y el resto de la API anda igual.
# Para saber qué falta: docker compose exec web python manage.py probar_firebase
# CAFETO_FIREBASE_CREDENCIAL=/run/secrets/firebase.json
