      },
      {
        "parameters": {
          "jsCode": "return $input.first().json.productos.map((p) => ({ json: p }));"
        },
        "name": "Uno por producto",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          0
        ]
      },
      {
        "parameters": {
          "url": "=https://world.openfoodfacts.org/api/v2/product/{{ $json.codigo_barras }}.json?fields=brands,image_front_url",
          "options": {
            "batching": {
              "batch": {
                "batchSize": 1,
                "batchInterval": 1500
              }
            },
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "name": "Buscar en Open Food Facts",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          0
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const p = $('Uno por producto').item.json;\nconst d = $input.item.json;\nif (d.status !== 1 || !d.product) return null;\nconst cuerpo = {};\nif (p.sin_foto && d.product.image_front_url) cuerpo.url = d.product.image_front_url.replace(/^http:/, 'https:');\nconst marca = (d.product.brands || '').split(',')[0].trim();\nif (marca) cuerpo.marca = marca;\nif (!cuerpo.url && !cuerpo.marca) return null;\nreturn { json: { id: p.id, cuerpo } };"
        },
        "name": "Qué se puede completar",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.CAFETO_URL }}/api/servicio/productos/{{ $json.id }}/enriquecer/",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{ $env.CAFETO_N8N_TOKEN }}"
              }
            ]
          },
          "options": {},
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json.cuerpo) }}"
        },
        "name": "Completar el producto",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1100,
          0
        ]
      }
    ],
