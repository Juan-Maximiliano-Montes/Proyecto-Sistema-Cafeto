          "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $env.CAFETO_WHATSAPP_DUENIA + '@c.us', text: $json.texto }) }}",
          "options": {}
        },
        "name": "Mandar por WhatsApp",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
