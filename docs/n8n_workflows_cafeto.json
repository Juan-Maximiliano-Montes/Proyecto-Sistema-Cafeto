          "jsCode": "// Sólo el sistema puede pedir: el mismo token que usa la API de servicio.\nconst pedido = $input.first().json;\nconst token = (pedido.headers || {})['x-cafeto-token'];\nif (!$env.CAFETO_N8N_TOKEN || token !== $env.CAFETO_N8N_TOKEN) { return []; }\nconst b = pedido.body || {};\nconst renglones = (b.renglones || []).map(r => '• ' + r).join('\\n');\nconst texto = '📲 *¿Autorizás?* ' + b.pedido + '.\\n' +\n  'Total del ticket: ' + b.total + '\\n' + (renglones ? renglones + '\\n' : '') +\n  '\\nPara aprobar: ' + b.enlace + '\\n' +\n  'O dictale este PIN a la caja: *' + b.pin + '*\\n' +\n  'Vale hasta las ' + b.vence + '.';\nreturn [{ json: { texto } }];"
        },
