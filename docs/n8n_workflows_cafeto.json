        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst plata = (n) => '$ ' + Number(n).toLocaleString('es-AR', {minimumFractionDigits: 2});\nconst lineas = ['*Cafeto · cierre del ' + r.fecha + '*', '',\n  'Vendido: ' + plata(r.ventas_hoy), 'Ganancia bruta: ' + plata(r.ganancia_bruta_hoy)];\nfor (const m of r.desglose_medios_pago_hoy) lineas.push('  · ' + m.medio + ': ' + plata(m.total));\nif (r.renglones_sin_costo_hoy) lineas.push('', 'Ojo: ' + r.renglones_sin_costo_hoy + ' renglón(es) vendidos sin costo cargado.');\nif (r.avisos.length) { lineas.push('', '*Avisos*'); for (const a of r.avisos) lineas.push('  · ' + a.texto); }\nreturn [{ json: { texto: lineas.join('\\n') } }];"
        },
        "name": "Armar el mensaje",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          0
        ]
      },
      {
