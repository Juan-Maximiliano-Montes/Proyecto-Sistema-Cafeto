  {
    "name": "Cafeto · Factura por WhatsApp o correo → bandeja de compras",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "cafeto-whatsapp-factura",
          "responseMode": "onReceived",
          "options": {}
        },
        "name": "Llega un WhatsApp con la factura",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true
            },
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ $json.body.payload.hasMedia }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
