  {
    "name": "Cafeto · Vencimientos y fiados de la mañana",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 8 * * 1-6"
              }
            ]
          }
        },
        "name": "Lunes a sábado 8:00",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $env.CAFETO_URL }}/api/servicio/resumen/",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{ $env.CAFETO_N8N_TOKEN }}"
              }
            ]
          },
          "options": {}
        },
        "name": "Resumen del día",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          220,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst plata = (n) => '$ ' + Number(n).toLocaleString('es-AR', {minimumFractionDigits: 2});\nconst cc = r.cuentas_corrientes || {atrasados: [], vencen_pronto: []};\nif (!r.vencimientos_proximos.length && !cc.atrasados.length && !cc.vencen_pronto.length) return [];\nconst lineas = ['*Cafeto · buen día*'];\nif (r.vencimientos_proximos.length) {\n  lineas.push('', '*Para pagar en estos días*');\n  for (const v of r.vencimientos_proximos)\n    lineas.push((v.vencido ? 'VENCIDO ' : '') + v.vence + ' · ' + v.a_quien + ' · ' + v.concepto + ' · ' + plata(v.monto));\n}\nif (cc.atrasados.length) {\n  lineas.push('', '*Fiados atrasados* (te deben ' + plata(cc.te_deben) + ' en total)');\n  for (const c of cc.atrasados)\n    lineas.push('  · ' + c.cliente + ': ' + plata(c.vencido) + ' vencido' + (c.dias_de_atraso ? ', ' + c.dias_de_atraso + ' día(s)' : '') + (c.suspendido ? ' (suspendido)' : '') + (c.nota ? ' — ' + c.nota : ''));\n}\nif (cc.vencen_pronto.length) {\n  lineas.push('', '*Fiados que vencen en estos días*');\n  for (const c of cc.vencen_pronto) lineas.push('  · ' + c.vence + ' · ' + c.cliente + ' · ' + plata(c.falta));\n}\nreturn [{ json: { texto: lineas.join('\\n') } }];"
        },
        "name": "Sólo si hay algo que avisar",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          440,
          0
        ]
      },
